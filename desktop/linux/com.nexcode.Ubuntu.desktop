[Desktop Entry]
Type=Application
Name=NexCode
Comment=Local account and usage manager for Codex
Exec=nexcode-ubuntu %u
Icon=nexcode-ubuntu
Terminal=false
Categories=Development;
StartupNotify=true
StartupWMClass=com.nexcode.Ubuntu
MimeType=x-scheme-handler/nexcode;
Keywords=Codex;OpenAI;Account;Usage;AI;
